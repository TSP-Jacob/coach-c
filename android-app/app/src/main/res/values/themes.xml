<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Forced Light, not DayNight: the app hardcodes a light windowBackground
         and colors.xml has no values-night overrides, so on a device in system
         dark mode DayNight's default widget colors (e.g. TextInputEditText
         text/hint) resolved to light-on-light and were unreadable. Confirmed
         on a real device with system dark mode on. -->
    <style name="Theme.CoachC" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.CoachC.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.Assistant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>
</resources>
