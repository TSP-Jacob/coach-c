<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Forced Light, not DayNight: no values-night overrides exist, so
         DayNight's dark-mode widget colors would mismatch the hardcoded
         light windowBackground. Confirmed unreadable on a real device with
         system dark mode on before this fix. -->
    <style name="Theme.CoachC.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- Match the real site's own background, not a generic app blue —
             the status bar should look like part of the page, not chrome. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
